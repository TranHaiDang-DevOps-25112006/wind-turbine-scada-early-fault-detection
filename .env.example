
# BIẾN MÔI TRƯỜNG DỰ ÁN WIND SCADA EARLY FAULT DETECTION
# 1. ĐƯỜNG DẪN DỮ LIỆU
SCADA_DATA_DIR=data/raw
SCADA_SAMPLE_DIR=data/sample
SCADA_INTERIM_DIR=data/interim
SCADA_PROCESSED_DIR=data/processed

#2. THƯ MỤC LƯU TRỮ ARTIFACTS & BÁO CÁO
SCADA_MODEL_DIR=models
SCADA_REPORTS_DIR=reports
SCADA_LOGS_DIR=logs

#3. CẤU HÌNH THỰC THI & LOGGING
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

#4. CẤU HÌNH PYSPARK
# Trên Windows, nếu cần chỉ định Python worker cho PySpark:
# PYSPARK_PYTHON=.venv/Scripts/python.exe
# PYSPARK_DRIVER_PYTHON=.venv/Scripts/python.exe
SPARK_MASTER=local[*]